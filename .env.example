# Copie para `.env` e preencha. O `.env` nao vai para o git.

# ID do Formspree — a parte final da URL que eles geram.
# Ex.: se o endpoint for https://formspree.io/f/xdkoqwer, use xdkoqwer
VITE_FORMSPREE_ID=

# Anexo de curriculo em /trabalhe-conosco. Deixe vazio para manter desligado.
# So funciona em plano PAGO do Formspree (Personal ou acima) — no gratuito a
# cota de arquivo e 0 GB e o envio com anexo e recusado. Ligue com: 1
VITE_FORMSPREE_ANEXO=

# Dominio do site, usado no canonical, no og:url e no sitemap.
# Sem barra no fim.
VITE_SITE_URL=https://g2engenharia.com.br
